<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>آموزش زبان انگلیسی هفتم، هشتم و نهم | فاطمه سبحانی نسب</title>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/rastikerdar/vazirmatn@v33.003/Vazirmatn-font-face.css">
<style>
:root{--g1:#d4af37;--g2:#f4d97a;--g3:#b8941f;--gg:linear-gradient(135deg,#d4af37 0%,#f4d97a 40%,#d4af37 60%,#b8941f 100%);--gc:linear-gradient(135deg,#f9ecc9 0%,#e8cf8f 50%,#d4af37 100%);--r:22px}
body[data-theme="dark"]{--bg:#050b18;--bg1:#0a1730;--bg2:#0d1e3d;--card:linear-gradient(155deg,#0d2044 0%,#081428 100%);--cs:#0d2044;--tx:#eaeff8;--ts:#fff;--mu:#90a3c2;--ln:rgba(212,175,55,.28);--ln2:rgba(212,175,55,.14);--inp:rgba(13,32,68,.8);--sh:0 15px 40px rgba(0,0,0,.5);--shl:0 30px 70px rgba(0,0,0,.7);--glow:0 0 40px rgba(212,175,55,.25);--ov:rgba(5,11,24,.9)}
body[data-theme="light"]{--bg:#f7f1e0;--bg1:#fdf9ef;--bg2:#fffdf7;--card:linear-gradient(155deg,#fffdf7 0%,#f5ecd3 100%);--cs:#fffdf7;--tx:#1a2440;--ts:#0a1730;--mu:#6b7a94;--ln:rgba(168,132,42,.35);--ln2:rgba(168,132,42,.18);--inp:#fffdf7;--sh:0 15px 40px rgba(120,90,20,.12);--shl:0 30px 70px rgba(120,90,20,.22);--glow:0 0 40px rgba(212,175,55,.3);--ov:rgba(40,30,5,.55)}
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
body{font-family:'Vazirmatn',Tahoma,sans-serif;background:radial-gradient(1400px 700px at 80% -10%,rgba(212,175,55,.1),transparent 60%),radial-gradient(1000px 600px at -10% 30%,rgba(21,48,89,.5),transparent 60%),var(--bg);color:var(--tx);line-height:1.9;overflow-x:hidden;min-height:100vh;transition:.4s}
header{position:sticky;top:0;z-index:100;background:linear-gradient(180deg,var(--bg1) 0%,color-mix(in srgb,var(--bg1) 92%,transparent) 100%);backdrop-filter:blur(20px);border-bottom:1px solid var(--ln)}
header.scrolled{box-shadow:0 15px 40px rgba(0,0,0,.35)}
.nav{max-width:1250px;margin:auto;padding:14px 22px;display:flex;align-items:center;justify-content:space-between;gap:14px;flex-wrap:wrap}
.logo{display:flex;align-items:center;gap:12px;font-weight:900;font-size:1.02rem;color:var(--ts)}
.logo .dot{width:46px;height:46px;border-radius:14px;background:var(--gg);display:grid;place-items:center;font-size:1.3rem;color:#0a1730;font-weight:900;box-shadow:0 10px 28px -6px rgba(212,175,55,.7),inset 0 1px 0 rgba(255,255,255,.5),0 0 0 1px rgba(212,175,55,.4)}
.nav-links{display:flex;gap:10px;align-items:center;flex-wrap:wrap}
.nav-links .home-link{text-decoration:none;color:var(--mu);font-weight:800;font-size:.84rem;padding:9px 16px;border-radius:50px;transition:.3s;border:1px solid var(--ln2);display:inline-flex;align-items:center;gap:6px}
.nav-links .home-link:hover{color:var(--g2);border-color:var(--g1);background:rgba(212,175,55,.08);transform:translateY(-2px)}
.nav-tools{display:flex;gap:6px;align-items:center;padding:6px;background:var(--gc);border:1.5px solid var(--g1);border-radius:50px;box-shadow:0 10px 28px -10px rgba(212,175,55,.7),inset 0 1px 0 rgba(255,255,255,.7),inset 0 -1px 0 rgba(168,132,42,.2);transition:.3s}
.nav-tools:hover{box-shadow:0 14px 34px -10px rgba(212,175,55,1),inset 0 1px 0 rgba(255,255,255,.9)}
.nav-tools button{width:38px;height:38px;border-radius:50%;border:none;background:rgba(255,255,255,.45);color:#0a1730;font-weight:900;font-size:1.02rem;display:grid;place-items:center;cursor:pointer;transition:.35s;position:relative;font-family:inherit;box-shadow:0 3px 8px -3px rgba(0,0,0,.15),inset 0 1px 0 rgba(255,255,255,.9)}
.nav-tools button:hover{background:#0a1730;color:var(--g2);transform:translateY(-3px) scale(1.1);box-shadow:0 12px 24px -8px rgba(10,23,48,.7)}
.nav-tools button .badge{position:absolute;top:-3px;left:-3px;background:linear-gradient(135deg,#ec4899,#be185d);color:#fff;font-size:.6rem;font-weight:900;padding:2px 6px;border-radius:50px;min-width:18px;text-align:center;border:1.5px solid #f9ecc9;box-shadow:0 3px 8px rgba(236,72,153,.5);line-height:1}
.social-nav{display:flex;gap:8px}
.social-ico{width:42px;height:42px;border-radius:12px;display:grid;place-items:center;text-decoration:none;transition:.3s;color:#fff;box-shadow:0 8px 22px -8px rgba(0,0,0,.4),inset 0 1px 0 rgba(255,255,255,.25)}
.social-ico svg{width:22px;height:22px;fill:currentColor}
.social-ico.ig{background:linear-gradient(135deg,#f09433,#e6683c,#dc2743,#cc2366,#bc1888)}
.social-ico.wa{background:linear-gradient(135deg,#25D366,#128C7E)}
.social-ico:hover{transform:translateY(-3px) scale(1.05);box-shadow:0 14px 30px -8px rgba(0,0,0,.5)}
.hero{position:relative;overflow:hidden;text-align:center;padding:90px 20px 140px;background:radial-gradient(900px 500px at 50% 0%,rgba(212,175,55,.18),transparent 70%),linear-gradient(180deg,var(--bg1) 0%,var(--bg) 100%);border-bottom:1px solid var(--ln)}
.hero::before{content:"";position:absolute;inset:0;background-image:linear-gradient(rgba(212,175,55,.05) 1px,transparent 1px),linear-gradient(90deg,rgba(212,175,55,.05) 1px,transparent 1px);background-size:60px 60px;mask-image:radial-gradient(ellipse at center,#000 40%,transparent 78%);pointer-events:none}
.hero::after{content:"";position:absolute;top:-100px;left:50%;transform:translateX(-50%);width:600px;height:600px;background:radial-gradient(circle,rgba(212,175,55,.15) 0%,transparent 65%);pointer-events:none;animation:pulse 6s ease-in-out infinite}
@keyframes pulse{0%,100%{opacity:.6;transform:translateX(-50%) scale(1)}50%{opacity:1;transform:translateX(-50%) scale(1.15)}}
.hero-inner{position:relative;z-index:2;max-width:900px;margin:auto}
.badge{display:inline-flex;align-items:center;gap:8px;background:rgba(212,175,55,.1);border:1px solid var(--ln);padding:8px 22px;border-radius:50px;font-size:.84rem;font-weight:700;color:var(--g2);margin-bottom:26px;backdrop-filter:blur(10px);box-shadow:0 8px 22px -10px rgba(212,175,55,.5)}
.hero h1{font-size:2.4rem;font-weight:900;line-height:1.3;margin-bottom:20px;color:var(--ts);letter-spacing:-.5px}
.hero .sub-lead{font-size:1.05rem;color:var(--mu);margin-bottom:32px;max-width:640px;margin-inline:auto;font-weight:500}
.grade-boxes{display:flex;gap:18px;justify-content:center;flex-wrap:wrap;margin:0 auto 36px;max-width:720px}
.gbox{position:relative;flex:1;min-width:170px;max-width:220px;padding:28px 24px 24px;border-radius:20px;background:var(--gc);border:1.5px solid var(--g1);color:#0a1730;font-weight:900;text-align:center;overflow:hidden;box-shadow:0 20px 45px -18px rgba(212,175,55,.8),inset 0 1px 0 rgba(255,255,255,.8),0 0 0 1px rgba(255,255,255,.4);transition:.4s cubic-bezier(.2,.9,.3,1);cursor:default}
.gbox::before{content:"";position:absolute;top:-50%;left:-50%;width:200%;height:200%;background:linear-gradient(115deg,transparent 30%,rgba(255,255,255,.7) 50%,transparent 70%);transform:translateX(-100%);transition:.8s;animation:shine 4s infinite}
@keyframes shine{0%,70%{transform:translateX(-100%) rotate(0)}100%{transform:translateX(100%) rotate(0)}}
.gbox:hover{transform:translateY(-8px) scale(1.04);box-shadow:0 30px 60px -20px rgba(212,175,55,1),inset 0 1px 0 rgba(255,255,255,1)}
.gbox .g-num{font-size:1.9rem;font-weight:900;line-height:1;margin-bottom:6px;text-shadow:0 2px 4px rgba(255,255,255,.6);position:relative;z-index:2}
.gbox .g-name{font-size:1.05rem;font-weight:900;letter-spacing:.3px;position:relative;z-index:2}
.gbox .g-en{font-size:.7rem;font-weight:700;opacity:.65;direction:ltr;margin-top:2px;position:relative;z-index:2}
@media(max-width:520px){.grade-boxes{gap:10px}.gbox{min-width:105px;padding:20px 12px 16px}.gbox .g-num{font-size:1.4rem}.gbox .g-name{font-size:.86rem}}
.btn{padding:15px 34px;border-radius:50px;font-weight:900;text-decoration:none;font-size:1rem;transition:.35s;border:none;cursor:pointer;font-family:inherit;display:inline-flex;align-items:center;gap:10px;letter-spacing:.2px}
.btn-gold{background:var(--gg);color:#0a1730;box-shadow:0 18px 40px -12px rgba(212,175,55,.9),inset 0 2px 0 rgba(255,255,255,.5),0 0 0 1px rgba(212,175,55,.4)}
.btn-gold:hover{transform:translateY(-4px);box-shadow:0 25px 50px -12px rgba(212,175,55,1),inset 0 2px 0 rgba(255,255,255,.6)}
.social-hero{display:flex;gap:12px;justify-content:center;flex-wrap:wrap;margin-bottom:30px}
.social-hero a{display:inline-flex;align-items:center;gap:9px;padding:12px 24px;border-radius:50px;text-decoration:none;color:#fff;font-weight:800;font-size:.88rem;transition:.35s;box-shadow:0 12px 30px -10px rgba(0,0,0,.4),inset 0 1px 0 rgba(255,255,255,.25)}
.social-hero a svg{width:19px;height:19px;fill:currentColor}
.social-hero a.ig{background:linear-gradient(135deg,#f09433,#dc2743,#bc1888)}
.social-hero a.wa{background:linear-gradient(135deg,#25D366,#128C7E)}
.social-hero a:hover{transform:translateY(-4px) scale(1.03)}
.teacher{display:inline-flex;align-items:center;gap:12px;background:rgba(21,48,89,.4);border:1px solid var(--ln);padding:12px 24px;border-radius:50px;font-size:.92rem;color:var(--mu);backdrop-filter:blur(10px);box-shadow:0 10px 30px -12px rgba(0,0,0,.4)}
.teacher strong{color:var(--g2);font-weight:900}
.wrap{max-width:1200px;margin:auto;padding:0 22px}
.sec-title{text-align:center;margin-bottom:14px;font-size:2.1rem;font-weight:900;color:var(--ts);display:block;width:100%;letter-spacing:-.5px}
.sec-title::after{content:"";display:block;width:90px;height:4px;margin:18px auto 0;background:var(--gg);border-radius:4px;box-shadow:0 0 24px rgba(212,175,55,.7)}
.sec-sub{text-align:center;color:var(--mu);margin-bottom:48px;font-size:1rem;font-weight:500}
.grades{padding:80px 0 40px;margin-top:-80px;position:relative;z-index:10}
.grade-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(270px,1fr));gap:26px}
.grade-card{background:var(--card);border:1px solid var(--ln);border-radius:var(--r);padding:42px 28px;text-align:center;cursor:pointer;transition:.5s cubic-bezier(.2,.9,.3,1);position:relative;overflow:hidden;box-shadow:var(--sh)}
.grade-card::before{content:"";position:absolute;top:0;left:0;right:0;height:4px;background:var(--gg);box-shadow:0 0 20px rgba(212,175,55,.6)}
.grade-card::after{content:"";position:absolute;inset:0;background:linear-gradient(115deg,transparent 40%,rgba(212,175,55,.15) 50%,transparent 60%);transform:translateX(-100%);transition:.8s}
.grade-card:hover::after{transform:translateX(100%)}
.grade-card:hover,.grade-card.active{transform:translateY(-14px);border-color:var(--g1);box-shadow:var(--shl),var(--glow)}
.g-ico{width:92px;height:92px;border-radius:26px;margin:0 auto 22px;display:grid;place-items:center;font-size:2.3rem;font-weight:900;color:#0a1730;background:var(--gg);transition:.5s;box-shadow:0 20px 40px -12px rgba(212,175,55,.8),inset 0 2px 0 rgba(255,255,255,.5),0 0 0 1px rgba(212,175,55,.4)}
.grade-card:hover .g-ico{transform:rotate(-10deg) scale(1.12)}
.grade-card h3{font-size:1.55rem;font-weight:900;margin-bottom:8px;color:var(--ts)}
.grade-card .book{color:var(--mu);font-size:.86rem;margin-bottom:22px;font-weight:600}
.grade-card .go{display:inline-block;padding:12px 30px;border-radius:50px;font-weight:900;font-size:.87rem;color:var(--g2);background:rgba(212,175,55,.1);border:1px solid var(--ln);transition:.35s}
.grade-card:hover .go{background:var(--gg);color:#0a1730;border-color:transparent;box-shadow:0 12px 28px -8px rgba(212,175,55,.9)}
.lessons-sec{padding:60px 0 100px}
.lessons-head{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:16px;margin-bottom:24px;padding:24px 28px;border-radius:var(--r);background:var(--card);border:1px solid var(--ln);box-shadow:var(--sh)}
.lessons-head h2{font-size:1.3rem;font-weight:900;display:flex;align-items:center;gap:12px;color:var(--ts);flex-wrap:wrap}
.lessons-head h2 .bar{width:6px;height:28px;border-radius:6px;background:var(--gg);box-shadow:0 0 16px rgba(212,175,55,.7)}
.lessons-head h2 small{font-size:.72rem;color:var(--mu);font-weight:600}
.speed{display:flex;align-items:center;gap:8px;font-size:.82rem;color:var(--mu);font-weight:700;flex-wrap:wrap}
.speed button{border:1px solid var(--ln);background:rgba(212,175,55,.05);padding:8px 15px;border-radius:50px;cursor:pointer;font-family:inherit;font-size:.78rem;font-weight:800;color:var(--mu);transition:.3s}
.speed button:hover{border-color:var(--g1);color:var(--g2)}
.speed button.on{background:var(--gg);border-color:transparent;color:#0a1730;box-shadow:0 8px 20px -6px rgba(212,175,55,.8)}
.lesson{background:var(--card);border:1px solid var(--ln);border-radius:var(--r);margin-bottom:16px;overflow:hidden;transition:.35s;box-shadow:var(--sh)}
.lesson:hover{border-color:rgba(212,175,55,.5)}
.lesson.open{border-color:var(--g1);box-shadow:var(--shl),var(--glow)}
.lesson-head{padding:20px 24px;display:flex;align-items:center;gap:16px;cursor:pointer;transition:.3s}
.lesson-head:hover{background:rgba(212,175,55,.05)}
.lnum{width:52px;height:52px;border-radius:16px;flex-shrink:0;display:grid;place-items:center;font-weight:900;color:#0a1730;font-size:1.1rem;background:var(--gg);box-shadow:0 12px 26px -8px rgba(212,175,55,.8),inset 0 2px 0 rgba(255,255,255,.4)}
.ltitle{font-weight:900;font-size:1.05rem;color:var(--ts);direction:ltr;text-align:right;letter-spacing:.2px}
.lsub{font-size:.8rem;color:var(--mu);margin-top:3px;font-weight:600}
.arrow{width:36px;height:36px;border-radius:50%;background:rgba(212,175,55,.1);border:1px solid var(--ln);display:grid;place-items:center;transition:.4s;color:var(--g2);flex-shrink:0;font-size:.75rem;font-weight:900}
.lesson.open .arrow{transform:rotate(180deg);background:var(--gg);color:#0a1730;border-color:transparent;box-shadow:0 8px 20px -6px rgba(212,175,55,.8)}
.lesson-body{display:grid;grid-template-rows:0fr;transition:grid-template-rows .5s ease}
.lesson-inner{overflow:hidden;min-height:0}
.lesson.open .lesson-body{grid-template-rows:1fr}
.tabs{display:flex;gap:8px;padding:0 24px 16px;border-bottom:1px solid var(--ln);flex-wrap:wrap}
.tab{padding:11px 22px;border-radius:50px;border:1px solid var(--ln);background:rgba(212,175,55,.05);cursor:pointer;font-family:inherit;font-weight:800;font-size:.84rem;color:var(--mu);transition:.3s}
.tab:hover{color:var(--g2);border-color:var(--g1)}
.tab.on{background:var(--gg);color:#0a1730;border-color:transparent;box-shadow:0 10px 24px -8px rgba(212,175,55,.9)}
.pane{padding:26px 24px 32px;display:none}
.pane.on{display:block;animation:fade .4s}
@keyframes fade{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}
.playall{display:inline-flex;align-items:center;gap:9px;background:var(--gg);color:#0a1730;border:none;padding:13px 26px;border-radius:50px;cursor:pointer;font-family:inherit;font-weight:900;font-size:.86rem;margin-bottom:20px;transition:.35s;box-shadow:0 14px 30px -10px rgba(212,175,55,.9),inset 0 2px 0 rgba(255,255,255,.4)}
.playall:hover{transform:translateY(-3px);box-shadow:0 20px 40px -10px rgba(212,175,55,1)}
.playall.stop{background:linear-gradient(135deg,#ef4444,#b91c1c);color:#fff;box-shadow:0 14px 30px -10px rgba(239,68,68,.8)}
.words{display:grid;grid-template-columns:repeat(auto-fill,minmax(255px,1fr));gap:12px}
.word{display:flex;align-items:center;gap:12px;padding:14px 16px;border-radius:16px;background:var(--inp);border:1px solid var(--ln);transition:.3s}
.word:hover{background:var(--bg2);border-color:var(--g1);transform:translateX(-5px);box-shadow:0 12px 30px -12px rgba(212,175,55,.6)}
.word.speaking{background:rgba(212,175,55,.15);border-color:var(--g1);box-shadow:0 0 0 4px rgba(212,175,55,.18)}
.spk{width:40px;height:40px;border-radius:50%;border:none;flex-shrink:0;cursor:pointer;background:var(--gg);color:#0a1730;font-size:.95rem;display:grid;place-items:center;transition:.3s;box-shadow:0 10px 24px -8px rgba(212,175,55,.9),inset 0 1px 0 rgba(255,255,255,.5)}
.spk:hover{transform:scale(1.15);box-shadow:0 14px 30px -8px rgba(212,175,55,1)}
.spk:active{transform:scale(.95)}
.w-en{font-weight:900;font-size:.98rem;color:var(--ts);direction:ltr;text-align:left;letter-spacing:.2px}
.w-fa{font-size:.84rem;color:var(--mu);font-weight:500}
.heart{width:36px;height:36px;border-radius:50%;border:1px solid var(--ln);background:transparent;cursor:pointer;font-size:.95rem;display:grid;place-items:center;transition:.3s;flex-shrink:0}
.heart:hover{transform:scale(1.15);border-color:#ec4899}
.heart.on{background:linear-gradient(135deg,#ec4899,#be185d);border-color:transparent;color:#fff;box-shadow:0 10px 24px -8px rgba(236,72,153,.8)}
.conv{display:flex;flex-direction:column;gap:14px}
.line{display:flex;gap:14px;align-items:flex-start;padding:16px;border-radius:18px;background:var(--inp);border:1px solid var(--ln);transition:.3s}
.line:hover{background:var(--bg2);border-color:var(--g1);box-shadow:0 12px 30px -14px rgba(212,175,55,.6)}
.line.speaking{background:rgba(212,175,55,.15);border-color:var(--g1);box-shadow:0 0 0 4px rgba(212,175,55,.18)}
.avatar{width:44px;height:44px;border-radius:50%;flex-shrink:0;display:grid;place-items:center;font-weight:900;color:#0a1730;font-size:.98rem;background:var(--gg);box-shadow:0 10px 24px -8px rgba(212,175,55,.8),inset 0 1px 0 rgba(255,255,255,.5)}
.line .body{flex:1;min-width:0}
.line .en{font-weight:800;direction:ltr;text-align:left;color:var(--ts);font-size:.95rem}
.line .fa{font-size:.84rem;color:var(--mu);margin-top:5px}
.gram-box{background:linear-gradient(135deg,rgba(212,175,55,.12),rgba(212,175,55,.02));border:1.5px solid var(--ln);border-radius:20px;padding:22px 24px;margin-bottom:18px;box-shadow:0 12px 30px -14px rgba(212,175,55,.5)}
.gram-title{font-size:1.05rem;font-weight:900;color:var(--g2);margin-bottom:14px;direction:ltr;text-align:right;display:flex;align-items:center;gap:10px;text-shadow:0 0 20px rgba(212,175,55,.5)}
.gram-title::before{content:"📘";font-size:1.15rem}
.gram-body{font-size:.92rem;color:var(--tx);line-height:2.05;margin-bottom:16px;padding:16px;border-radius:14px;background:var(--inp);border:1px solid var(--ln2)}
.gram-body strong{color:var(--g2);font-weight:900;padding:1px 6px;border-radius:6px;background:rgba(212,175,55,.12)}
.gram-ex{display:flex;flex-direction:column;gap:10px}
.gram-ex-item{display:flex;align-items:center;gap:12px;padding:12px 14px;border-radius:14px;background:var(--inp);border:1px solid var(--ln2);transition:.3s}
.gram-ex-item:hover{background:var(--bg2);border-color:var(--g1);box-shadow:0 10px 24px -12px rgba(212,175,55,.5)}
.gram-ex-item.speaking{background:rgba(212,175,55,.15);border-color:var(--g1)}
.gram-ex-item .en{flex:1;font-weight:800;direction:ltr;text-align:left;color:var(--ts);font-size:.9rem}
.gram-ex-item .fa{font-size:.8rem;color:var(--mu);min-width:100px;text-align:left;font-weight:500}
.empty{text-align:center;padding:80px 20px;color:var(--mu);background:var(--card);border-radius:var(--r);border:1.5px dashed var(--ln);box-shadow:var(--sh)}
.empty .big{font-size:3.5rem;margin-bottom:16px;opacity:.7;filter:drop-shadow(0 0 20px rgba(212,175,55,.5))}
.empty h3{font-size:1.2rem;color:var(--ts);margin-bottom:10px;font-weight:900}
footer{background:linear-gradient(180deg,var(--bg1),var(--bg));color:var(--mu);padding:65px 22px 35px;text-align:center;border-top:1px solid var(--ln);position:relative}
footer::before{content:"";position:absolute;top:0;left:50%;transform:translateX(-50%);width:160px;height:3px;background:var(--gg);border-radius:3px;box-shadow:0 0 30px rgba(212,175,55,.8)}
footer .fname{font-size:1.5rem;font-weight:900;margin-bottom:8px;background:var(--gg);-webkit-background-clip:text;background-clip:text;color:transparent;letter-spacing:-.3px}
footer .fdesc{font-size:.9rem;margin-bottom:32px;font-weight:600}
.qr-section{display:flex;gap:30px;justify-content:center;flex-wrap:wrap;margin-bottom:34px}
.qr-card{background:var(--card);border:1.5px solid var(--ln);border-radius:20px;padding:20px;min-width:185px;transition:.4s;box-shadow:var(--sh)}
