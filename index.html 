function renderStats(){const total=Object.keys(DATA).reduce((s,k)=>s+DATA[k].lessons.length,0);const opened=Object.keys(progress).length;const reads=Object.values(progress).reduce((a,b)=>a+b,0);let h=`<div class="stat-grid"><div class="stat-card"><div class="num">${opened}</div><div class="lbl">درس باز شده</div></div><div class="stat-card"><div class="num">${favs.length}</div><div class="lbl">کلمه ذخیره‌شده</div></div><div class="stat-card"><div class="num">${reads}</div><div class="lbl">بازدید از درس‌ها</div></div><div class="stat-card"><div class="num">${total}</div><div class="lbl">کل درس‌ها</div></div></div>`;Object.keys(DATA).forEach(gk=>{const g=DATA[gk];let d=0;g.lessons.forEach((_,i)=>{if(progress[gk+'-'+i])d++});const p=Math.round(d/g.lessons.length*100);h+=`<div class="progress-item"><div class="row"><span>${g.name}</span><span class="pct">${p}%</span></div><div class="progress-bar"><div class="fill" style="width:${p}%"></div></div></div>`});document.getElementById('statsBody').innerHTML=h}

let quizState=null;
function startQuiz(les,gradeKey,idx){const qs=[];const aw=[];Object.keys(DATA).forEach(gk=>DATA[gk].lessons.forEach(l=>l.v.forEach(w=>aw.push(w))));les.v.forEach(w=>{const o=aw.filter(x=>x[1]!==w[1]);const wr=[];while(wr.length<3){const r=o[Math.floor(Math.random()*o.length)];if(r&&!wr.some(x=>x[1]===r[1]))wr.push(r)}const ops=[w,...wr].sort(()=>Math.random()-0.5);qs.push({q:w[0],a:w[1],opts:ops.map(x=>x[1])})});quizState={qs,cur:0,score:0,les,gradeKey,idx};renderQuiz();document.getElementById('modalQuiz').classList.add('show')}
function renderQuiz(){const s=quizState;if(s.cur>=s.qs.length){const p=Math.round(s.score/s.qs.length*100);const st=p>=90?'⭐⭐⭐':p>=70?'⭐⭐':p>=50?'⭐':'';document.getElementById('quizBody').innerHTML=`<div class="quiz-result"><div class="score">${p}%</div><div class="stars">${st}</div><div class="msg">${s.score} از ${s.qs.length} پاسخ صحیح</div></div>`;document.getElementById('quizFoot').innerHTML=`<button class="btn-sm gold" onclick="startQuiz(quizState.les,quizState.gradeKey,quizState.idx)">🔄 دوباره</button><button class="btn-sm" style="background:var(--inp);color:var(--tx);border:1px solid var(--ln)" onclick="document.getElementById('modalQuiz').classList.remove('show')">بستن</button>`;return}const q=s.qs[s.cur];const p=Math.round(s.cur/s.qs.length*100);document.getElementById('quizBody').innerHTML=`<div class="quiz-progress"><div class="bar" style="width:${p}%"></div></div><div style="text-align:center;color:var(--mu);font-size:.8rem">سوال ${s.cur+1} از ${s.qs.length}</div><div class="quiz-q">${q.q}</div><div class="quiz-q-fa">معنی درست را انتخاب کن</div>${q.opts.map((o,i)=>`<button class="quiz-opt" onclick="answerQuiz(${i})">${o}</button>`).join('')}`;document.getElementById('quizFoot').innerHTML=''}
function answerQuiz(i){const s=quizState,q=s.qs[s.cur];const b=document.querySelectorAll('.quiz-opt');b.forEach(x=>x.disabled=true);if(q.opts[i]===q.a){b[i].classList.add('correct');s.score++}else{b[i].classList.add('wrong');b.forEach(x=>{if(x.textContent===q.a)x.classList.add('correct')})}setTimeout(()=>{s.cur++;renderQuiz()},1200)}

document.querySelectorAll('.modal-close').forEach(b=>{b.onclick=()=>document.getElementById(b.dataset.close).classList.remove('show')});
document.querySelectorAll('.modal-bg').forEach(m=>{m.onclick=e=>{if(e.target===m)m.classList.remove('show')}});

document.getElementById('btnTheme').onclick=()=>{const c=document.body.dataset.theme;const n=c==='dark'?'light':'dark';document.body.dataset.theme=n;document.getElementById('btnTheme').textContent=n==='dark'?'🌙':'☀️';localStorage.setItem('theme',n)};
const st=localStorage.getItem('theme')||'dark';document.body.dataset.theme=st;document.getElementById('btnTheme').textContent=st==='dark'?'🌙':'☀️';
updateFavCount();
const hdr=document.getElementById('hdr'),topBtn=document.getElementById('top');
window.addEventListener('scroll',()=>{hdr.classList.toggle('scrolled',window.scrollY>20);topBtn.classList.toggle('show',window.scrollY>500)});
</script>
</body>
