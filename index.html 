function buildLesson(les,idx,gradeKey){
  const el=document.createElement('div');el.className='lesson';
  el.innerHTML=`<div class="lesson-head"><div class="lnum">${idx+1}</div><div style="flex:1;min-width:0"><div class="ltitle">${les.t}</div><div class="lsub">${les.sub} — ${les.v.length} کلمه</div></div><div class="arrow">▼</div></div><div class="lesson-body"><div class="lesson-inner"><div class="tabs"><button class="tab on" data-p="v">📖 واژگان</button><button class="tab" data-p="g">📘 گرامر</button><button class="tab" data-p="c">💬 مکالمه</button></div><div class="pane on" data-p="v"><div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:16px"><button class="playall" data-all="v">🔊 پخش همه</button><button class="playall" data-all="q" style="background:linear-gradient(135deg,#10b981,#059669);color:#fff">📝 آزمون</button></div><div class="words"></div></div><div class="pane" data-p="g"><div class="gram-box"><div class="gram-title">${les.g.t}</div><div class="gram-body">${les.g.b}</div><div class="gram-ex">${les.g.e.map(([en,fa])=>`<div class="gram-ex-item"><button class="spk">🔊</button><div class="en">${en}</div><div class="fa">${fa}</div></div>`).join('')}</div></div></div><div class="pane" data-p="c"><button class="playall" data-all="c">🔊 پخش مکالمه</button><div class="conv"></div></div></div></div>`;
  const wb=el.querySelector('.words');
  les.v.forEach(([en,fa])=>{const w=document.createElement('div');w.className='word';w.innerHTML=`<button class="spk">🔊</button><div style="flex:1;min-width:0"><div class="w-en">${en}</div><div class="w-fa">${fa}</div></div><button class="heart ${isFav(en)?'on':''}">❤️</button>`;w.querySelector('.spk').onclick=e=>{e.stopPropagation();speakWord(en,w.querySelector('.spk'))};w.querySelector('.heart').onclick=e=>{e.stopPropagation();const h=e.currentTarget;if(isFav(en)){const i=favs.findIndex(f=>f.en===en);favs.splice(i,1);h.classList.remove('on');showToast('حذف شد')}else{favs.push({en,fa,grade:gradeKey});h.classList.add('on');showToast('ذخیره شد ⭐')}saveFavs()};wb.appendChild(w)});
  const cb=el.querySelector('.conv');
  les.c.forEach(([sp,en,fa])=>{const l=document.createElement('div');l.className='line';l.innerHTML=`<div class="avatar">${sp}</div><div class="body"><div class="en">${en}</div><div class="fa">${fa}</div></div><button class="spk">🔊</button>`;l.querySelector('.spk').onclick=e=>{e.stopPropagation();speakWord(en,l.querySelector('.spk'))};cb.appendChild(l)});
  el.querySelectorAll('.gram-ex-item .spk').forEach((b,i)=>{b.onclick=e=>{e.stopPropagation();speakWord(les.g.e[i][0],b)}});
  el.querySelectorAll('.tab').forEach(t=>{t.onclick=e=>{e.stopPropagation();el.querySelectorAll('.tab').forEach(x=>x.classList.remove('on'));el.querySelectorAll('.pane').forEach(p=>p.classList.remove('on'));t.classList.add('on');el.querySelector(`.pane[data-p="${t.dataset.p}"]`).classList.add('on');el.classList.add('open')}});
  el.querySelector('[data-all="v"]').onclick=function(e){e.stopPropagation();playList(les.v.map(x=>x[0]),this)};
  el.querySelector('[data-all="c"]').onclick=function(e){e.stopPropagation();playList(les.c.map(x=>x[1]),this)};
  el.querySelector('[data-all="q"]').onclick=function(e){e.stopPropagation();startQuiz(les,gradeKey,idx)};
  el.querySelector('.lesson-head').onclick=()=>{const w=el.classList.contains('open');if(playing){speechSynthesis.cancel();playing=false;document.querySelectorAll('.playall').forEach(b=>{b.classList.remove('stop');if(b.dataset.orig)b.innerHTML=b.dataset.orig})}document.querySelectorAll('.lesson').forEach(l=>l.classList.remove('open'));if(!w){el.classList.add('open');const k=gradeKey+'-'+idx;progress[k]=(progress[k]||0)+1;saveProg()}};
  return el;
}

