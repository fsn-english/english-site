{t:"Lesson 4 — My City",sub:"شهر من",v:[["city","شهر"],["street","خیابان"],["park","پارک"],["library","کتابخانه"],["museum","موزه"],["hospital","بیمارستان"],["bank","بانک"],["restaurant","رستوران"],["supermarket","سوپرمارکت"],["mosque","مسجد"],["square","میدان"],["traffic","ترافیک"],["pollution","آلودگی"],["crowded","شلوغ"],["quiet","ساکت"],["building","ساختمان"],["bridge","پل"],["tower","برج"]],c:[["A","Is your city big or small?","شهرت بزرگ یا کوچک؟"],["B","It's a big and crowded city.","بزرگ و شلوغ."],["A","What places are there in your city?","چه مکان‌هایی هست؟"],["B","There are parks, museums and libraries.","پارک، موزه و کتابخانه."],["A","Is the traffic heavy?","ترافیک سنگین است؟"],["B","Yes, there is a lot of traffic.","بله، ترافیک زیادی هست."]],g:{t:"There is / There are",b:"<strong>There is</strong> با اسم مفرد و <strong>There are</strong> با اسم جمع. سوال: Is there...? / Are there...?",e:[["There is a park near my house.","نزدیک خانه‌ام پارکی هست."],["There are many shops.","مغازه‌های زیادی وجود دارد."],["Is there a bank here?","اینجا بانکی هست؟"],["There aren't any museums.","هیچ موزه‌ای نیست."],["There is a lot of traffic.","ترافیک زیادی هست."],["There are two libraries.","دو کتابخانه هست."]]}},
