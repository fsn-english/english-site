let currentRate=0.7,voiceList=[],voicesReady=false;
function loadVoices(){if(!('speechSynthesis' in window))return;const v=speechSynthesis.getVoices();if(v&&v.length){voiceList=v;voicesReady=true}}
if('speechSynthesis' in window){loadVoices();speechSynthesis.onvoiceschanged=loadVoices;setTimeout(loadVoices,100);setTimeout(loadVoices,500);setTimeout(loadVoices,1500)}
function pickVoice(){if(!voiceList.length)loadVoices();const p=[/Google US English/i,/Microsoft Aria/i,/Microsoft Jenny/i,/Microsoft Zira/i,/Samantha/i,/Karen/i];for(const r of p){const f=voiceList.find(v=>r.test(v.name));if(f)return f}return voiceList.find(v=>v.lang==='en-US')||voiceList.find(v=>v.lang&&v.lang.startsWith('en'))||null}
function showToast(m){const t=document.getElementById('toast');t.textContent=m;t.classList.add('show');clearTimeout(showToast._t);showToast._t=setTimeout(()=>t.classList.remove('show'),2200)}
function warmup(){try{const u=new SpeechSynthesisUtterance(' ');u.volume=0;speechSynthesis.speak(u)}catch(e){}loadVoices();document.removeEventListener('click',warmup)}
document.addEventListener('click',warmup,{once:true});
function speak(text,rate,cb){if(!('speechSynthesis' in window)){showToast('مرورگر پشتیبانی نمی‌کند');return}try{speechSynthesis.cancel()}catch(e){}const run=()=>{const u=new SpeechSynthesisUtterance(text);u.lang='en-US';u.rate=rate||currentRate;u.pitch=1;u.volume=1;const v=pickVoice();if(v)u.voice=v;if(cb)u.onend=cb;u.onerror=()=>{if(cb)cb()};try{speechSynthesis.speak(u)}catch(e){}};if(!voicesReady||!voiceList.length){loadVoices();setTimeout(run,150)}else{run()}}
let activeEl=null;
function speakWord(t,b){if(activeEl)activeEl.classList.remove('speaking');const x=b.closest('.word, .line, .gram-ex-item');if(x){x.classList.add('speaking');activeEl=x}speak(t,currentRate,()=>{if(x)x.classList.remove('speaking');if(activeEl===x)activeEl=null})}
let playing=false;
function playList(items,btn){if(!('speechSynthesis' in window)){showToast('مرورگر پشتیبانی نمی‌کند');return}if(playing){speechSynthesis.cancel();playing=false;btn.classList.remove('stop');if(btn.dataset.orig)btn.innerHTML=btn.dataset.orig;return}playing=true;btn.dataset.orig=btn.innerHTML;btn.classList.add('stop');btn.innerHTML='⏹ توقف';let i=0;const n=()=>{if(!playing||i>=items.length){playing=false;btn.classList.remove('stop');btn.innerHTML=btn.dataset.orig;return}const u=new SpeechSynthesisUtterance(items[i++]);u.lang='en-US';u.rate=currentRate;u.pitch=1;const v=pickVoice();if(v)u.voice=v;u.onend=()=>setTimeout(n,420);u.onerror=()=>setTimeout(n,200);try{speechSynthesis.speak(u)}catch(e){n()}};n()}

const favs=JSON.parse(localStorage.getItem('favs')||'[]');
