const gradeGrid=document.getElementById('gradeGrid'),lessonWrap=document.getElementById('lessonWrap');
Object.keys(DATA).forEach(k=>{const g=DATA[k];const el=document.createElement('div');el.className='grade-card';el.dataset.grade=k;el.innerHTML=`<div class="g-ico">${g.icon}</div><h3>${g.name}</h3><div class="book">${g.book} — ${g.lessons.length} درس</div><div class="go">مشاهده درس‌ها</div>`;el.onclick=()=>openGrade(k,el);gradeGrid.appendChild(el)});

function openGrade(key,cardEl){
  document.querySelectorAll('.grade-card').forEach(c=>c.classList.remove('active'));
  if(cardEl)cardEl.classList.add('active');
  if(playing){speechSynthesis.cancel();playing=false}
  activeEl=null;
  const g=DATA[key];
  lessonWrap.innerHTML=`<div class="lessons-head"><h2><span class="bar"></span> فهرست ${g.name} <small>(${g.book})</small></h2><div class="speed"><span>سرعت:</span><button data-r="0.5">آهسته</button><button data-r="0.7" class="on">مبتدی</button><button data-r="0.9">معمولی</button><button data-r="1.1">سریع</button></div></div><div id="lessonList"></div>`;
  lessonWrap.querySelectorAll('.speed button').forEach(b=>{b.onclick=()=>{lessonWrap.querySelectorAll('.speed button').forEach(x=>x.classList.remove('on'));b.classList.add('on');currentRate=parseFloat(b.dataset.r);showToast('سرعت: '+b.textContent)}});
  const list=document.getElementById('lessonList');
  g.lessons.forEach((les,i)=>list.appendChild(buildLesson(les,i,key)));
